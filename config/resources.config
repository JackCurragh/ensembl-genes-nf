// Resource allocation definitions for process labels.
//
// Strategy
// --------
// Base resources are defined per label.  On retry (OOM or timeout) both memory
// and time scale automatically so SLURM routes the re-submitted job to whatever
// queue accepts those resources — no partition names are hard-coded here.
//
// Memory doubles each attempt (×2^(attempt-1)):  attempt 1 = 1×, 2 = 2×, 3 = 4×
// Time grows linearly (×attempt):                attempt 1 = 1×, 2 = 2×, 3 = 3×
//
// Rationale: OOM almost always means the tool needs roughly 2× memory, so
// exponential steps avoid repeated single-unit increments that still fail.
// Time failures are usually marginal so linear increments are enough.
//
// Guard rails: check_max() (defined in nextflow.config) caps all requests at
// params.max_memory / params.max_cpus / params.max_time.
//
// Exit codes that trigger retry (resource exhaustion signals):
//   137  SIGKILL  — Linux OOM killer
//   143  SIGTERM  — SLURM pre-emption / walltime warning signal
//   104  SIGBUS   — memory bus error (OOM adjacent)
//   134  SIGABRT  — abort (tool-level OOM guard)
//   139  SIGSEGV  — segfault (often OOM-induced)
// All other exit codes are treated as tool errors → 'finish' (don't burn retries).

// Convenience closure — keeps label blocks DRY
def retry_on_oom = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'finish' }

process {

    // ── Single-core utility processes ──────────────────────────────────────
    // Short scripts, manifest writers, small file ops.
    withLabel: process_single {
        cpus          = 1
        memory        = { check_max(1.GB  * (1 << (task.attempt - 1)), 'memory') }   // 1 → 2 → 4 GB
        time          = { check_max(30.m  * task.attempt,              'time'  ) }   // 30m → 1h → 1.5h
        errorStrategy = retry_on_oom
        maxRetries    = 2
    }

    // ── Light processes ────────────────────────────────────────────────────
    // QC, small file operations, quick Python scripts.
    withLabel: process_light {
        cpus          = 1
        memory        = { check_max(2.GB  * (1 << (task.attempt - 1)), 'memory') }   // 2 → 4 → 8 GB
        time          = { check_max(1.h   * task.attempt,              'time'  ) }   // 1h → 2h → 3h
        errorStrategy = retry_on_oom
        maxRetries    = 3
    }

    // ── Low resource processes ─────────────────────────────────────────────
    // Downloads, indexing, parsing, light alignment.
    withLabel: process_low {
        cpus          = 2
        memory        = { check_max(8.GB  * (1 << (task.attempt - 1)), 'memory') }   // 8 → 16 → 32 GB
        time          = { check_max(4.h   * task.attempt,              'time'  ) }   // 4h → 8h → 12h
        errorStrategy = retry_on_oom
        maxRetries    = 3
    }

    // ── Medium resource processes ──────────────────────────────────────────
    // GenBlast batches, Exonerate, moderate alignment.
    withLabel: process_medium {
        cpus          = 4
        memory        = { check_max(16.GB * (1 << (task.attempt - 1)), 'memory') }   // 16 → 32 → 64 GB
        time          = { check_max(8.h   * task.attempt,              'time'  ) }   // 8h → 16h → 24h
        errorStrategy = retry_on_oom
        maxRetries    = 3
    }

    // ── High resource processes ────────────────────────────────────────────
    // STAR alignment, RepeatMasker chunks, StringTie assembly.
    withLabel: process_high {
        cpus          = 8
        memory        = { check_max(32.GB * (1 << (task.attempt - 1)), 'memory') }   // 32 → 64 → 128 GB
        time          = { check_max(12.h  * task.attempt,              'time'  ) }   // 12h → 24h → 36h
        errorStrategy = retry_on_oom
        maxRetries    = 3
    }

    // ── High memory processes ──────────────────────────────────────────────
    // STAR genome index, large genome loading, data structures > 64 GB.
    withLabel: process_high_memory {
        cpus          = 4
        memory        = { check_max(64.GB * (1 << (task.attempt - 1)), 'memory') }   // 64 → 128 → 256 GB
        time          = { check_max(8.h   * task.attempt,              'time'  ) }   // 8h → 16h → 24h
        errorStrategy = retry_on_oom
        maxRetries    = 2
    }

    // ── Long running processes ─────────────────────────────────────────────
    // Large genome RepeatMasker, lastz whole-genome alignment.
    withLabel: process_long {
        cpus          = 4
        memory        = { check_max(16.GB * (1 << (task.attempt - 1)), 'memory') }   // 16 → 32 → 64 GB
        time          = { check_max(24.h  * task.attempt,              'time'  ) }   // 24h → 48h → 72h
        errorStrategy = retry_on_oom
        maxRetries    = 2
    }

    // ── Single-threaded long-running processes ─────────────────────────────
    // Sequential steps that need wall-time but not many cores.
    withLabel: process_single_long {
        cpus          = 1
        memory        = { check_max(8.GB  * (1 << (task.attempt - 1)), 'memory') }   // 8 → 16 → 32 GB
        time          = { check_max(12.h  * task.attempt,              'time'  ) }   // 12h → 24h → 36h
        errorStrategy = retry_on_oom
        maxRetries    = 3
    }

    // ── RepeatModeler — de novo repeat library construction ────────────────
    // Single-node multi-threaded.  A 2.5 GB mammal genome needs ~5–7 days at 32 CPU.
    // Memory is generous upfront because retrying days-long jobs is expensive.
    withLabel: process_repeatmodeler {
        cpus          = 32
        memory        = { check_max(64.GB * (1 << (task.attempt - 1)), 'memory') }   // 64 → 128 GB
        time          = { check_max(7.d   * task.attempt,              'time'  ) }   // 7d → 14d
        errorStrategy = retry_on_oom
        maxRetries    = 2
    }

    // ── Master pipeline launcher jobs ──────────────────────────────────────
    // Each submits `nextflow run ./pipelines/X` and blocks until the child
    // pipeline finishes.  Minimal resources; must not be retried on failure
    // (child work is preserved by -resume if re-run manually).
    withLabel: process_launcher {
        cpus          = 1
        memory        = '2.GB'
        time          = '7.d'
        errorStrategy = 'finish'
    }
}
