/*
========================================================================================
    QC THRESHOLDS & ALGORITHM PARAMETERS
========================================================================================
    Single source of truth for every numeric threshold and tuneable parameter
    in the ensembl-genes-nf pipeline.

    Categories
    ──────────
    1. Run-level QC          — which RNA-seq / long-read runs to include
    2. Model quality filters  — minimum quality for assembled / aligned models
    3. Validation scoring     — weights and thresholds for validate_models
    4. Algorithm parameters   — not QC gates, but tuneable behaviour

    To override for a single run:
      nextflow run . --min_mapping_pct 70 --min_pid 60 ...

    To override for all runs at a site:
      Create a local.config with the params you want to change and add
      `includeConfig 'local.config'` at the bottom of nextflow.config.

    Rejection logging
    ─────────────────
    Every filtering step writes a standardised rejection TSV to
      <outdir>/qc_reports/<stage>.rejected.tsv
    with columns: stage, item_type, item_id, reason, threshold_name,
                  threshold_value, observed_value
    These are aggregated by the COLLECT_QC_REPORT step at the end of the run.
========================================================================================
*/

params {

    // ── 1. Run-level QC ──────────────────────────────────────────────────────
    // Minimum STAR uniquely_mapped_reads_percentage to accept a run from the
    // genebuild transcriptome registry.  Runs below this were either mis-mapped,
    // contaminated, or wrong species — exclude them regardless of qc_status.
    min_mapping_pct         = 60.0

    // Maximum number of ENA runs to download per BioProject accession.
    // Prevents runaway download of huge projects; increase if you expect more.
    max_rnaseq_runs         = 50
    max_longread_runs       = 200

    // ── 2. Model quality filters ─────────────────────────────────────────────

    // StringTie transcript assembly (rnaseq pipeline)
    // Transcripts below these thresholds are dropped before GFF3 output.
    stringtie_min_coverage  = 2.0   // read coverage (FPKM-like, StringTie 'cov' attribute)
    stringtie_min_length    = 200   // transcript length in bp
    stringtie_min_exons     = 1     // minimum number of exons (1 = monoexonic allowed)

    // Protein alignment quality (best_targeted, igtr)
    // Applied to Exonerate / GenBlast protein-to-genome alignments.
    min_pid                 = 50.0  // minimum % sequence identity
    min_coverage            = 50.0  // minimum % query coverage

    // Projection — minimum chain coverage to keep a projected transcript
    projection_min_coverage = 50.0

    // ncRNA BLAST filtering (short_ncrna pipeline)
    ncrna_blast_min_pid     = 95.0
    ncrna_blast_max_evalue  = "1e-3"

    // GenBlast parameters
    genblast_max_rank       = 5     // maximum ranked hits per query protein
    protein_batch_size      = 100   // proteins per parallel GenBlast batch

    // ── 3. Validation scoring (validate_models pipeline) ─────────────────────

    // Minimum STAR junction unique-read depth to count an intron as 'supported'.
    // Lower = more permissive; increase to 5-10 for high-coverage datasets.
    min_junction_depth      = 3

    // Structural score below which a transcript is flagged structural_ok=false.
    // Score is graded: 1.0 = all checks pass, 0.0 = in-frame stop codon found.
    structural_score_pass   = 0.7

    // Composite validation score weights.
    // Must sum to 1.0.  Increase splice_weight if RNA-seq evidence is deep.
    validation_struct_weight = 0.4
    validation_splice_weight = 0.6

    // DIAMOND blastp thresholds for protein validation in validate_models.
    blast_evalue            = "1e-5"
    blast_min_pid           = 30.0   // permissive — just checking it's a real protein
    blast_min_cov           = 50.0

    // ── 4. Algorithm parameters ───────────────────────────────────────────────

    // STAR sjdbOverhang — should equal (read_length - 1).
    // 149 is correct for 150 bp reads.  Set to 74 for 75 bp, 99 for 100 bp.
    sjdb_overhang           = 149

    // Long-read collapse: minimum reciprocal exon overlap to merge two isoforms
    collapse_min_overlap    = 0.9

    // Maximum intron size (bp) before a CIGAR N operation is treated as a
    // chimeric alignment rather than a genuine intron.
    max_intron_size         = 1000000

}
