/*
========================================================================================
    ANNOTATION PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit base configuration (resources, error handling, reporting)
includeConfig '../../nextflow.config'

// Plugins
plugins {
    id 'nf-schema@2.2.0'
}

// Pipeline-specific parameters
params {
    // Input/Output
    outdir = './results/annotation'

    // Pipeline mode
    mode = 'both'                       // 'global', 'pergene', or 'both'

    // Required inputs (common)
    gtf = null                          // Reference GTF annotation
    fasta = null                        // Reference genome FASTA

    // Optional RNA-Seq inputs (enhances both branches)
    rnaseq_results_dir = null           // RNA-Seq pipeline results directory

    // ========================================================================
    // GLOBAL ANNOTATION INPUTS
    // ========================================================================
    riboseq_results_dir = null          // Ribo-Seq pipeline results directory

    // Global clustering parameters
    similarity_method = 'correlation'   // 'correlation', 'cosine', or 'euclidean'
    similarity_threshold = 0.8          // Global clustering threshold (0.0-1.0)

    // Translon calling parameters
    translon_callers = 'orfquant,ribocode,ribotish'  // Comma-separated list
    // Available: orfquant, ribocode, ribotish, orfrater, deepribo

    // Consensus annotation parameters
    min_caller_agreement = 2            // Minimum callers to support novel translon
    conservation_scores = null          // Optional PhyloP/PhastCons scores

    // ========================================================================
    // PER-GENE ANNOTATION INPUTS
    // ========================================================================
    count_matrix = null                 // Unique RPFs × samples matrix (parquet)
    merged_bam = null                   // All samples merged BAM
    sample_offsets = null               // Per-sample offset files

    // Per-gene clustering parameters
    pergene_similarity_method = 'correlation'   // Similarity method for per-gene
    pergene_similarity_threshold = 0.8          // Per-gene clustering threshold
    min_cluster_size = 3                        // Minimum samples per gene-cluster

    // Per-gene detection parameters
    min_periodicity_score = 0.5         // Minimum 3-nt periodicity
    min_coverage = 10                   // Minimum reads per translon
    p_value_threshold = 0.05            // Statistical significance threshold
}

// Process-specific configuration
process {
    // High memory processes
    withLabel: 'process_high_memory' {
        memory = { 32.GB * task.attempt }
        time = '12.h'
        errorStrategy = { task.exitStatus in [137,140] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    // ========================================================================
    // GLOBAL ANNOTATION PROCESSES
    // ========================================================================

    // Global profile computation
    withName: 'GLOBAL_ANNOTATION:COMPUTE_GLOBAL_PROFILES' {
        cpus = 8
        memory = { 16.GB * task.attempt }
        time = '4.h'
    }

    // BAM merging - high I/O
    withName: 'GLOBAL_ANNOTATION:MERGE_CLUSTER_BAMS' {
        cpus = 8
        memory = { 8.GB * task.attempt }
        time = '6.h'
    }

    // Translon callers - variable resource requirements
    withName: 'GLOBAL_ANNOTATION:CALL_TRANSLONS:RUN_ORFQUANT' {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = '8.h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'GLOBAL_ANNOTATION:CALL_TRANSLONS:RUN_RIBOCODE' {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = '8.h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'GLOBAL_ANNOTATION:CALL_TRANSLONS:RUN_RIBOTISH' {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = '8.h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'GLOBAL_ANNOTATION:CALL_TRANSLONS:RUN_ORFRATER' {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = '8.h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'GLOBAL_ANNOTATION:CALL_TRANSLONS:RUN_DEEPRIBO' {
        cpus = 8
        memory = { 32.GB * task.attempt }
        time = '24.h'
        // Uncomment if GPU available
        // accelerator = 1
        // clusterOptions = '--gres=gpu:1'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // ========================================================================
    // PER-GENE ANNOTATION PROCESSES
    // ========================================================================

    // Per-gene clustering - runs for each gene
    withName: 'PERGENE_ANNOTATION:CLUSTER_PERGENE' {
        cpus = 4
        memory = { 8.GB * task.attempt }
        time = '4.h'
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // Gene BAM extraction - high I/O
    withName: 'PERGENE_ANNOTATION:EXTRACT_GENE_BAMS' {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = '2.h'
    }

    // Profile generation per gene-cluster
    withName: 'PERGENE_ANNOTATION:GENERATE_CLUSTER_PROFILES' {
        cpus = 4
        memory = { 8.GB * task.attempt }
        time = '4.h'
    }

    // Profile-based detection
    withName: 'PERGENE_ANNOTATION:PROFILE_BASED_DETECTION' {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = '6.h'
    }

    // Statistical tests
    withName: 'PERGENE_ANNOTATION:STATISTICAL_TESTS' {
        cpus = 4
        memory = { 8.GB * task.attempt }
        time = '4.h'
    }
}

// Execution profiles
profiles {
    // Default: SLURM with Singularity (for HPC cluster execution)
    slurm {
        process {
            executor = 'slurm'
        }
        singularity {
            enabled = true
            autoMounts = true
        }
    }

    // Local execution with Singularity (for testing/development)
    local {
        process {
            executor = 'local'
            maxForks = 2
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = './singularity_cache'
        }
    }

    // Conda-based execution
    conda {
        conda {
            enabled = true
            useMicromamba = true
            cacheDir = './conda_cache'
        }
        singularity.enabled = false
    }

    // Docker execution
    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        singularity.enabled = false
    }
}
