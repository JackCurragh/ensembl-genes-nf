/*
========================================================================================
    VALIDATE_MODELS PIPELINE CONFIGURATION
========================================================================================
*/

// Inherit all shared settings: resources, thresholds, profiles, Singularity config.
includeConfig '../../nextflow.config'

params {
    gff3_files   = null   // comma-separated list of GFF3 paths
    genome_fasta = null
    sj_tabs      = null   // optional: comma-sep STAR SJ.out.tab paths
    protein_db   = null   // optional: UniProt FASTA for DIAMOND blastp
    outdir       = null
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }

    withName: 'VALIDATE_MODELS' {
        cpus       = 2
        memory     = { 8.GB  * task.attempt }
        time       = '2.h'
        maxRetries = 2
    }
    withName: 'DIAMOND_BLASTP' {
        cpus       = 8
        memory     = { 16.GB * task.attempt }
        time       = '4.h'
        maxRetries = 2
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}
