/*
========================================================================================
    PANGENOME_PROJECTION PIPELINE CONFIGURATION
========================================================================================
    Projects gene models from a reference genome onto a target assembly using
    minimap2-based coordinate projection (Ensembl ensembl-genes pangenome tool).

    Runs alongside the chain-based PROJECTION pipeline for side-by-side comparison.
========================================================================================
*/

includeConfig '../../nextflow.config'

params {
    // ── Required ─────────────────────────────────────────────────────────────
    source_fasta  = null   // reference genome FASTA
    source_gff3   = null   // reference annotation GFF3
    target_fasta  = null   // target (new) genome FASTA (softmasked)
    outdir        = null

    // ── Tool location ─────────────────────────────────────────────────────────
    // Pre-cloned ensembl-genes repo at feature/human_pangenome_mapping.
    // If null, the process will clone from GitHub at runtime (requires internet
    // access on compute nodes — fine for local/dev, problematic on HPC).
    pangenome_tool_dir = null

    // ── Alignment ─────────────────────────────────────────────────────────────
    // preset_profile: none | ultra-close | less-close
    //   none        — raw minimap2 defaults (asm5)
    //   ultra-close — tuned for >99% identity (e.g. GRCh38 → CHM13)
    //   less-close  — tuned for 95-99% identity (e.g. GRCh38 → macaque)
    pangenome_preset    = 'none'
    pangenome_min_identity     = 0.95
    pangenome_min_block_length = 10000
    pangenome_min_mapq         = 10

    // ── QC ────────────────────────────────────────────────────────────────────
    pangenome_protein_qc_min_identity = 0.90
    pangenome_protein_qc_min_coverage = 0.90
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }

    withName: 'PANGENOME_MAP' {
        cpus       = 8
        memory     = { 32.GB * task.attempt }
        time       = '6.h'
        maxRetries = 2
    }
    withName: 'WRITE_MANIFEST' {
        memory = '1.GB'
        time   = '10.m'
    }
}
