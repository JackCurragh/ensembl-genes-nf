// Base nextflow.config — shared configuration for all pipelines.
// Pipeline-specific configs can override anything here.

// Include standard resource definitions
includeConfig 'config/resources.config'
includeConfig 'config/shared-module.config'


// Pipeline metadata
manifest {
    name            = 'EnsEMBL Genebuild Pipeline Collection'
    author          = 'EnsEMBL Genebuild'
    homePage        = 'https://github.com/ensembl/ensembl-genes-nf'
    description     = 'Collection of bioinformatics pipelines'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Default process settings
// ---------------------------------------------------------------------------
process {
    cpus   = 1
    memory = '4.GB'
    time   = '2.h'

    // Pipelines use shell -euo pipefail so multi-command processes stop on
    // first failure; undefined variables and pipe failures are caught.
    shell  = ['/bin/bash', '-euo', 'pipefail']

    maxErrors = '-1'   // don't halt the whole pipeline on isolated job errors
}

// ---------------------------------------------------------------------------
// Global params — inherited by all pipelines
// ---------------------------------------------------------------------------
params {
    outdir   = './results'
    tracedir = "${params.outdir}/pipeline_info"

    // Guard rails — cap any label's resource request at these maxima.
    // Override per-cluster in the cluster profile below.
    max_memory = 512.GB
    max_cpus   = 64
    max_time   = 14.d
}

// ---------------------------------------------------------------------------
// Execution reporting
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/pipeline_dag.svg"
}

// ---------------------------------------------------------------------------
// Singularity — default for all environments
// ---------------------------------------------------------------------------
singularity {
    enabled    = true
    autoMounts = false         // prevent home directory contamination
    cacheDir   = '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'
    runOptions = '--cleanenv'  // avoid local package interference
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    // ── conda ─────────────────────────────────────────────────────────────
    // Serialise micromamba env creation to avoid lock contention.
    conda {
        process.maxForks      = 1
        singularity.enabled   = false
    }

    // ── local ─────────────────────────────────────────────────────────────
    // Run everything on the current machine; cap parallel annotation layers.
    local {
        process.executor       = 'local'
        singularity.enabled    = false
        params.nextflow_profile = 'local'

        process {
            withLabel: 'process_launcher' { maxForks = 4 }
        }

        params.max_memory = 32.GB
        params.max_cpus   = 8
        params.max_time   = 24.h
    }

    // ── cluster ───────────────────────────────────────────────────────────
    // Jobs are submitted to SLURM with only CPU, memory, and time declared.
    // The scheduler routes each job to the appropriate partition automatically
    // based on those resource requests — no partition names are hard-coded.
    // On retry, resources.config doubles memory and extends time so the job
    // naturally ends up in a higher-resource partition if one exists.
    cluster {
        process.executor        = 'slurm'
        params.nextflow_profile = 'cluster'

        singularity.cacheDir = '/hps/nobackup/flicek/ensembl/genebuild/singularity_cache'

        // Load nextflow + java in every SLURM job environment
        process.beforeScript = '''
            module load nextflow  2>/dev/null || true
            module load java/17   2>/dev/null || true
            export NXF_ANSI_LOG=false
        '''

        // Guard rails — hard ceiling on what any single job can request.
        // Set these to the largest node available on the cluster.
        params.max_memory = 512.GB
        params.max_cpus   = 64
        params.max_time   = 14.d

        // All jobs are single-node (no MPI); SLURM defaults ntasks=1 but
        // --nodes=1 is explicit to prevent spanning nodes on shared clusters.
        process.clusterOptions = '--ntasks=1 --nodes=1'
    }

    // ── stub ──────────────────────────────────────────────────────────────
    // Tests master DAG wiring without real compute.
    // The -stub flag is passed through to each sub-pipeline launch.
    stub {
        process.executor        = 'local'
        singularity.enabled     = false
        params.nextflow_profile = 'local'
    }
}

// ---------------------------------------------------------------------------
// Helper function — guard-railed resource requests
// Used in resources.config as: memory = { check_max(16.GB * task.attempt, 'memory') }
// ---------------------------------------------------------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "  ### ERROR check_max(memory) - ${obj} is not a valid memory value. Using default: ${params.max_memory}"
            return params.max_memory as nextflow.util.MemoryUnit
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "  ### ERROR check_max(time) - ${obj} is not a valid time value. Using default: ${params.max_time}"
            return params.max_time as nextflow.util.Duration
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            println "  ### ERROR check_max(cpus) - ${obj} is not a valid CPU value. Using default: ${params.max_cpus}"
            return params.max_cpus as int
        }
    }
}
